{
  "name": "cbc-uidms-api",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=24"
  },
  "scripts": {
    "start": "node --env-file=.env src/server.js",
    "dev": "node --env-file=.env --watch src/server.js",
    "test": "node --test --test-concurrency=1 test/*.test.js",
    "test:sql": "node --env-file=.env.integration --test test/sql.integration.test.js",
    "check": "node scripts/check.js",
    "db:check": "node --env-file=.env scripts/db-check.js",
    "admin:bootstrap": "node --env-file=.env scripts/bootstrap.js",
    "sessions:cleanup": "node --env-file=.env scripts/cleanup.js",
    "mail:worker": "node --env-file=.env scripts/mail-worker.js",
    "attachments:scan": "node --env-file=.env scripts/scan-attachments.js"
  },
  "dependencies": {
    "cookie-parser": "^1.4.7",
    "cors": "^2.8.5",
    "express": "^5.1.0",
    "express-rate-limit": "^8.1.0",
    "helmet": "^8.1.0",
    "mssql": "^12.0.0",
    "nodemailer": "^10.6.0",
    "otpauth": "^9.4.0",
    "zod": "^4.1.0"
  },
  "devDependencies": {
    "supertest": "^7.1.0"
  }
}

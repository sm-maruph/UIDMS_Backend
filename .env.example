NODE_ENV=development
HOST=127.0.0.1
PORT=4000
# Exact origins only, comma separated. Use the browser's real origin.
ALLOWED_ORIGINS=http://localhost:5173,http://127.0.0.1:5173
# Keep false unless behind a controlled reverse proxy. Configure its IP in production.
TRUST_PROXY=false
DB_SERVER=localhost
DB_PORT=1433
DB_NAME=CBC_UIDMS
DB_USER=uidms_api
DB_PASSWORD=REPLACE_WITH_A_STRONG_UNIQUE_DATABASE_PASSWORD
DB_ENCRYPT=true
# Local development with SQL Server self-signed certificate ONLY. Production must be false.
DB_TRUST_CERTIFICATE=true
# Generate with: node -e "console.log(require('node:crypto').randomBytes(32).toString('base64'))"
# Keep outside source control. Back up securely; losing this loses encrypted MFA/delivery data.
DATA_ENCRYPTION_KEY=REPLACE_WITH_32_BYTE_BASE64_KEY
SESSION_IDLE_MINUTES=15
SESSION_MAX_HOURS=8
COOKIE_SECURE=false
# Production must require MFA. Development also defaults to true.
MFA_REQUIRED=true
# Local fixture accounts only. Never enable on production or a remote server.
MOCK_LOGIN_ENABLED=false
# These LDAP fields are enough. Hybrid mode enables AD when the required fields are filled.
AUTH_MODE=ad
LDAP_HOST=
LDAP_PORT=389
LDAP_BASE_DN=
LDAP_USERNAME=
LDAP_PASSWORD=
LDAP_TIMEOUT=30000
# StartTLS on 389, or LDAP_SSL=true with LDAP_TLS=false and port 636 for LDAPS.
LDAP_SSL=false
LDAP_TLS=true
# Set both SSL/TLS switches explicitly false only for local-development plain LDAP.
# Optional certificate and directory overrides are documented in docs/AD-SETUP.md.
# Fixed trusted SMTP server; mail worker is optional until configured.
SMTP_HOST=
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=
SMTP_PASSWORD=
MAIL_FROM=uidms@combankbd.com
MAIL_ALLOWED_DOMAINS=combankbd.com
# Optional quarantine scanner worker; set the absolute clamscan executable path.
CLAMSCAN_PATH=
